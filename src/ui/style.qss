QMainWindow {
    background-color: #2e2e2e;
    color: white;
}

QWidget {
    background-color: #2e2e2e;
    color: white;
}

QPushButton {
    background-color: #4a4a4a;
    color: white;
    border: 1px solid #5a5a5a;
    padding: 5px;
    border-radius: 5px;
}

QPushButton:hover {
    background-color: #5a5a5a;
}

QComboBox {
    background-color: #4a4a4a;
    color: white;
    border: 1px solid #5a5a5a;
    padding: 5px;
    border-radius: 5px;
}

QLabel {
    color: white;
}

QLabel:hover {
    background-color: #5a5a5a;
}

QToolButton {
    background-color: #4a4a4a;
    color: white;
    border: 1px solid #5a5a5a;
    padding: 5px;
    border-radius: 5px;
}

QToolButton:hover {
    background-color: #5a5a5a;
}

QToolButton::menu-indicator {
    subcontrol-position: center right;
}

QMenuBar {
    background-color: #3a3a3a;
    color: white;
}

QMenuBar::item {
    background-color: #3a3a3a;
    color: white;
}

QMenuBar::item:selected {
    background-color: #5a5a5a;
}

QMenu {
    background-color: #3a3a3a;
    color: white;
}

QMenu::item {
    background-color: #3a3a3a;
    color: white;
}

QMenu::item:selected {
    background-color: #5a5a5a;
}

QDialog {
    background-color: #2e2e2e;
    color: white;
}

QLineEdit {
    background-color: #4a4a4a;
    color: white;
    border: 1px solid #5a5a5a;
    padding: 5px;
    border-radius: 5px;
}

QMessageBox {
    background-color: #2e2e2e;
    color: white;
}

QScrollArea {
    background-color: #2e2e2e;
}

QListWidget {
    background-color: #4a4a4a;
    color: white;
    border: 1px solid #5a5a5a;
    padding: 5px;
    border-radius: 5px;
}